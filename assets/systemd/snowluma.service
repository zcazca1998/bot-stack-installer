[Unit]
Description=SnowLuma OneBot service (extracted official image)
After=network-online.target snowluma-qq.service
Wants=network-online.target snowluma-qq.service

[Service]
Type=simple
User=snowluma
Group=snowluma
ExecStart=/usr/local/lib/bot-stack/snowluma-launch
Restart=on-abnormal
RestartSec=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
