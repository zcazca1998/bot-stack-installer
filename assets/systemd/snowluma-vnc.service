[Unit]
Description=x11vnc bridge for the QQ Xvfb display (127.0.0.1 only)
After=snowluma-qq.service
PartOf=snowluma-qq.service

[Service]
Type=simple
User=snowluma
Group=snowluma
ExecStart=/usr/local/lib/nbot/vnc-server-launch
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=snowluma-qq.service
