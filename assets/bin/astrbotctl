#!/usr/bin/env bash
set -Eeuo pipefail
command=${1:-status}
case "$command" in
  start|stop|restart) systemctl "$command" astrbot.service ;;
  status) systemctl status astrbot.service astrbot-watchdog.timer --no-pager -l ;;
  logs)
    shift
    case "${1:-all}" in
      all) journalctl -u astrbot.service --no-pager ;;
      -f|follow) journalctl -u astrbot.service -f ;;
      -n) journalctl -u astrbot.service -n "${2:-300}" --no-pager ;;
      *) echo 'Usage: astrbotctl logs [all|-f|-n NUMBER]' >&2; exit 2 ;;
    esac
    ;;
  update) exec bot-stack update-astrbot ;;
  doctor) exec bot-stack doctor ;;
  *) echo 'Usage: astrbotctl {start|stop|restart|status|logs|update|doctor}' >&2; exit 2 ;;
esac
