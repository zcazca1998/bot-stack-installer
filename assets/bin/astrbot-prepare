#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/nbot.conf
: "${ASTRBOT_ROOT:=/nbot/astrbot}" "${ASTRBOT_PORT:=6185}"
cd "$ASTRBOT_ROOT"
export PYTHONPATH="$ASTRBOT_ROOT/app"
config="$ASTRBOT_ROOT/data/cmd_config.json"
if [[ ! -f "$config" ]]; then
  # astrbot.cli init asks interactive [Y/n] questions and systemd provides no
  # stdin; feed affirmative answers. A short printf finishes before the reader
  # can exit, so pipefail never sees a SIGPIPE.
  printf 'y\ny\ny\ny\ny\n' | "$ASTRBOT_ROOT/.venv/bin/python" -m astrbot.cli init ||
    echo 'astrbot.cli init failed; continuing with a minimal config' >&2
fi
if [[ ! -f "$config" ]]; then
  mkdir -p "$ASTRBOT_ROOT/data"
  printf '{}\n' > "$config"
  chmod 0600 "$config"
fi
CONFIG_PATH=$config DASHBOARD_PORT=$ASTRBOT_PORT "$ASTRBOT_ROOT/.venv/bin/python" <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["CONFIG_PATH"])
# astrbot.cli init writes the config with a UTF-8 BOM; utf-8-sig reads both.
config = json.loads(path.read_text(encoding="utf-8-sig"))
dashboard = config.setdefault("dashboard", {})
port = int(os.environ["DASHBOARD_PORT"])
if dashboard.get("port") != port:
    dashboard["port"] = port
    temp = path.with_suffix(".json.tmp")
    temp.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    temp.replace(path)
PY
