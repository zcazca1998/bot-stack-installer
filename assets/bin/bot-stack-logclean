#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/bot-stack.conf

prune_age() {
  local dir=$1 days=$2
  [[ -d "$dir" ]] || return 0
  find "$dir" -type f -mtime "+$days" -delete 2>/dev/null || true
  find "$dir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
}

# QQ 客户端日志与崩溃转储只保留 7 天
prune_age "$SNOWLUMA_ROOT/config/QQ/logs" 7
prune_age "$SNOWLUMA_ROOT/config/QQ/crash_files" 7
prune_age "$SNOWLUMA_ROOT/config/QQ/crashinfo" 7
# SnowLuma / AstrBot 文件日志兜底（logrotate 之外的散文件）
prune_age "$SNOWLUMA_ROOT/logs" 14
prune_age "$ASTRBOT_ROOT/data/logs" 14
# 临时目录残留超过 3 天清理
if [[ -d "$SNOWLUMA_ROOT/tmp" ]]; then
  find "$SNOWLUMA_ROOT/tmp" -mindepth 1 -mtime +3 -exec rm -rf {} + 2>/dev/null || true
fi
