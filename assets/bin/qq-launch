#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/nbot.conf
: "${SNOWLUMA_ROOT:=/nbot/snowluma}"
release=$(readlink -f "$SNOWLUMA_ROOT/qq/current")
[[ -r "$release/.qq-executable" ]] || { echo "QQ executable metadata is missing" >&2; exit 3; }
relative=$(<"$release/.qq-executable")
executable="$release/$relative"
[[ -x "$executable" ]] || { echo "QQ executable is not executable: $executable" >&2; exit 3; }

export HOME="$SNOWLUMA_ROOT/home"
export XDG_CONFIG_HOME="$SNOWLUMA_ROOT/config"
export XDG_CACHE_HOME="$SNOWLUMA_ROOT/cache"
export XDG_DATA_HOME="$SNOWLUMA_ROOT/data"
export XDG_RUNTIME_DIR="$SNOWLUMA_ROOT/run/session"
export TMPDIR="$SNOWLUMA_ROOT/tmp"
export SNOWLUMA_HOOK_RUNTIME_DIR="$SNOWLUMA_ROOT/run/hook"
export DISPLAY=:91
export SNOWLUMA_QQ_FLAGS="--disable-gpu --disable-software-rasterizer --disable-gpu-compositing"

mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_RUNTIME_DIR" "$TMPDIR" "$SNOWLUMA_HOOK_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
find "$SNOWLUMA_HOOK_RUNTIME_DIR" -maxdepth 1 -type s -name 'mojo.*.*.sock' -delete 2>/dev/null || true

bus="$XDG_RUNTIME_DIR/dbus.sock"
rm -f "$bus"
dbus-daemon --session --fork --address="unix:path=$bus" --nopidfile
export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"

auth="$XDG_RUNTIME_DIR/Xauthority"
export XAUTHORITY="$auth"
rm -f "$auth"
touch "$auth"
xauth -f "$auth" add "$DISPLAY" . "$(mcookie)"
rm -f /tmp/.X11-unix/X91
Xvfb "$DISPLAY" -screen 0 1920x1080x24 -nolisten tcp -auth "$auth" &
xvfb_pid=$!
for _ in {1..300}; do
  [[ -S /tmp/.X11-unix/X91 ]] && break
  kill -0 "$xvfb_pid" 2>/dev/null || { echo "Xvfb exited during startup" >&2; exit 3; }
  sleep 0.1
done
[[ -S /tmp/.X11-unix/X91 ]] || { echo "Xvfb display did not become ready" >&2; exit 3; }

/usr/local/lib/nbot/qq-auto-login &
cd "$SNOWLUMA_ROOT"
# shellcheck disable=SC2086
exec "$executable" --no-sandbox $SNOWLUMA_QQ_FLAGS
