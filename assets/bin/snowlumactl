#!/usr/bin/env bash
set -Eeuo pipefail
command=${1:-status}
case "$command" in
  start) systemctl start snowluma-qq.service; systemctl --no-block start snowluma.service ;;
  stop) systemctl stop snowluma.service ;;
  restart) systemctl restart snowluma.service ;;
  status) systemctl status snowluma.service snowluma-qq.service snowluma-watchdog.timer --no-pager -l ;;
  logs)
    shift
    case "${1:-all}" in
      all) journalctl -u snowluma.service -u snowluma-qq.service --no-pager ;;
      -f|follow) journalctl -u snowluma.service -u snowluma-qq.service -f ;;
      -n) journalctl -u snowluma.service -u snowluma-qq.service -n "${2:-300}" --no-pager ;;
      *) echo 'Usage: snowlumactl logs [all|-f|-n NUMBER]' >&2; exit 2 ;;
    esac
    ;;
  qq-start) systemctl start snowluma-qq.service; systemctl --no-block start snowluma.service ;;
  qq-stop) systemctl stop snowluma.service snowluma-qq.service ;;
  qq-restart) systemctl stop snowluma.service; systemctl restart snowluma-qq.service; systemctl --no-block start snowluma.service ;;
  qq-status) exec /usr/local/lib/nbot/qq-status ;;
  login) exec qqlogin ;;
  configure-onebot) exec nbot configure-onebot ;;
  update) exec nbot update-snowluma ;;
  update-qq) exec nbot update-qq "${2:-}" ;;
  doctor) exec nbot doctor ;;
  *) echo 'Usage: snowlumactl {start|stop|restart|status|logs|qq-start|qq-stop|qq-restart|qq-status|login|configure-onebot|update|update-qq|doctor}' >&2; exit 2 ;;
esac
