#!/usr/bin/env bash
set -Eeuo pipefail
if [[ -r /etc/bot-stack.conf ]]; then
  source /etc/bot-stack.conf
fi
NOVNC_PORT=${NOVNC_PORT:-6080}
SNOWLUMA_ROOT=${SNOWLUMA_ROOT:-/snowluma}
command=${1:-status}
case "$command" in
  start) systemctl start snowluma-vnc.service snowluma-novnc.service ;;
  stop) systemctl stop snowluma-novnc.service snowluma-vnc.service ;;
  restart) systemctl restart snowluma-vnc.service snowluma-novnc.service ;;
  status) systemctl status snowluma-vnc.service snowluma-novnc.service --no-pager -l ;;
  logs)
    shift
    case "${1:-all}" in
      all) journalctl -u snowluma-vnc.service -u snowluma-novnc.service --no-pager ;;
      -f|follow) journalctl -u snowluma-vnc.service -u snowluma-novnc.service -f ;;
      -n) journalctl -u snowluma-vnc.service -u snowluma-novnc.service -n "${2:-300}" --no-pager ;;
      *) echo 'Usage: novncctl logs [all|-f|-n NUMBER]' >&2; exit 2 ;;
    esac
    ;;
  password) cat "$SNOWLUMA_ROOT/config/vnc-password" ;;
  url)
    printf 'Local:         http://127.0.0.1:%s/vnc.html\n' "$NOVNC_PORT"
    printf 'Reverse proxy: https://your.domain/novnc/vnc.html (see novncctl proxy-example)\n'
    ;;
  proxy-example) cat /usr/local/lib/bot-stack/novnc-proxy.example ;;
  update) exec bot-stack install-novnc ;;
  *) echo 'Usage: novncctl {start|stop|restart|status|logs|password|url|proxy-example|update}' >&2; exit 2 ;;
esac
