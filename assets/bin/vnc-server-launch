#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/nbot.conf
NOVNC_VNC_PORT=${NOVNC_VNC_PORT:-5901}
auth="$SNOWLUMA_ROOT/run/session/Xauthority"
passwd_file="$SNOWLUMA_ROOT/config/vnc-password"

# qq-launch owns the display; wait for Xvfb :91 and its Xauthority. Exit 0 on
# timeout so systemd stays quiet while QQ is stopped: WantedBy=snowluma-qq
# starts this bridge again on the next QQ start.
for _ in {1..3000}; do
  [[ -S /tmp/.X11-unix/X91 && -r "$auth" ]] && break
  sleep 0.1
done
if [[ ! -S /tmp/.X11-unix/X91 || ! -r "$auth" ]]; then
  echo 'QQ Xvfb display :91 did not appear; VNC bridge will start with the next QQ start' >&2
  exit 0
fi

# -localhost keeps the raw VNC port off the network; only websockify and
# local tools may connect. The reverse proxy fronts noVNC, never this port.
#
# 鉴权只由反向代理承担：访问必经 Caddy 的账号密码，回环上再加一道 VNC
# 密码不增加任何安全性，只让用户多记一个凭据。没有反代时才启用 VNC 密码，
# 避免裸奔。
auth_args=(-nopw)
if [[ ! -f /etc/systemd/system/caddy.service && -s "$passwd_file" ]]; then
  auth_args=(-passwdfile "$passwd_file")
fi
exec x11vnc -display :91 -auth "$auth" -localhost -rfbport "$NOVNC_VNC_PORT" \
  "${auth_args[@]}" -forever -shared -noxdamage -quiet
