#!/usr/bin/env bash
set -u
source /etc/nbot.conf
cgroup=/sys/fs/cgroup/system.slice/nbot-qq.service/cgroup.procs
deadline=$(( $(date +%s) + 90 ))
attempts=0
visual_misses=0

resolve_xvfb() {
  display= auth=
  [[ -r "$cgroup" ]] || return 1
  local pid xvfb_pid= args i
  while read -r pid; do
    [[ -r "/proc/$pid/comm" ]] || continue
    [[ $(<"/proc/$pid/comm") == Xvfb ]] && { xvfb_pid=$pid; break; }
  done < "$cgroup"
  [[ -n "$xvfb_pid" ]] || return 1
  mapfile -d '' -t args < "/proc/$xvfb_pid/cmdline"
  for ((i=0; i<${#args[@]}; i++)); do
    [[ ${args[$i]} =~ ^:[0-9]+$ ]] && display=${args[$i]}
    [[ ${args[$i]} == -auth ]] && auth=${args[$((i+1))]:-}
  done
  [[ -n "$display" && -r "$auth" ]]
}

main_window_visible() {
  # 主窗口（宽 >= 600）出现即视为已登录，比 login.enc 的写入快得多。
  local w width
  for w in $(DISPLAY="$display" XAUTHORITY="$auth" xdotool search --onlyvisible --name '^QQ$' 2>/dev/null); do
    width=$(DISPLAY="$display" XAUTHORITY="$auth" xdotool getwindowgeometry --shell "$w" 2>/dev/null | sed -n 's/^WIDTH=//p')
    [[ "$width" =~ ^[0-9]+$ ]] && ((width >= 600)) && return 0
  done
  return 1
}

while (( $(date +%s) < deadline )); do
  state=$(/usr/local/lib/nbot/qq-login-state --machine 2>/dev/null || echo unknown)
  [[ "$state" == logged-in ]] && exit 0
  resolve_xvfb || { sleep 2; continue; }
  main_window_visible 2>/dev/null && exit 0
  [[ "$state" == quick-login ]] || { sleep 2; continue; }
  window=$(DISPLAY="$display" XAUTHORITY="$auth" xdotool search --onlyvisible --name '^QQ$' 2>/dev/null | tail -1 || true)
  [[ -n "$window" ]] || { sleep 2; continue; }
  geometry=$(DISPLAY="$display" XAUTHORITY="$auth" xdotool getwindowgeometry --shell "$window" 2>/dev/null || true)
  win_x=$(sed -n 's/^X=//p' <<<"$geometry")
  win_y=$(sed -n 's/^Y=//p' <<<"$geometry")
  width=$(sed -n 's/^WIDTH=//p' <<<"$geometry")
  height=$(sed -n 's/^HEIGHT=//p' <<<"$geometry")
  [[ "$win_x" =~ ^[0-9]+$ && "$win_y" =~ ^[0-9]+$ ]] || { sleep 2; continue; }
  [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || { sleep 2; continue; }
  # 自适应：登录窗口按尺寸范围识别（与 qqlogin 一致），点击位置按比例换算。
  # 高度 71% 即 320x460 布局中的快捷登录按钮；8 秒无反应换 66% 再试一次。
  ((width >= 260 && width <= 520 && height >= 340 && height <= 650)) || { sleep 2; continue; }
  # 优先视觉定位：找到登录按钮的蓝色色带质心，不依赖固定尺寸或布局。
  x= y= how=
  if spot=$(/usr/local/lib/nbot/qq-find-login-button "$display" "$auth" \
              "$win_x" "$win_y" "$width" "$height" 2>/dev/null); then
    read -r x y <<<"$spot"
    how=visual
  fi
  # QQ 冷启动时窗口先是空白/加载态，按钮尚未渲染。给视觉定位留出
  # 重试窗口，不要立刻退化成比例估算。
  if [[ -z "${x:-}" ]] && ((visual_misses < 10)); then
    visual_misses=$((visual_misses + 1))
    sleep 2
    continue
  fi
  if [[ -z "${x:-}" || -z "${y:-}" ]]; then
    case $attempts in
      0) x=$((width / 2)); y=$((height * 71 / 100)); how=ratio-71 ;;
      1) x=$((width / 2)); y=$((height * 66 / 100)); how=ratio-66 ;;
      *) break ;;
    esac
  elif ((attempts >= 2)); then
    break
  fi
  # Electron 只在窗口获得焦点后才处理合成的点击；先激活再按压。
  DISPLAY="$display" XAUTHORITY="$auth" xdotool windowactivate --sync "$window" 2>/dev/null || true
  DISPLAY="$display" XAUTHORITY="$auth" xdotool mousemove --window "$window" "$x" "$y" 2>/dev/null || true
  sleep 0.3
  DISPLAY="$display" XAUTHORITY="$auth" xdotool mousedown 1 2>/dev/null || true
  sleep 0.12
  DISPLAY="$display" XAUTHORITY="$auth" xdotool mouseup 1 2>/dev/null || true
  attempts=$((attempts + 1))
  logger -t nbot "QQ quick-login click attempt ${attempts} (${how}, visual-misses=${visual_misses}) at ${x},${y} in ${width}x${height} window"
  sleep 8
done

state=$(/usr/local/lib/nbot/qq-login-state --machine 2>/dev/null || echo unknown)
[[ "$state" == logged-in ]] && exit 0
resolve_xvfb && main_window_visible 2>/dev/null && exit 0
logger -t nbot 'No safe QQ quick-login action was available; manual qqlogin may be required'
exit 0
